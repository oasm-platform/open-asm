# Config database
POSTGRES_HOST=localhost
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
POSTGRES_DB=open_asm
POSTGRES_SSL=false

PORT=6276
GRPC_PORT=16276
OASM_CLOUD_APIKEY=change_me
REDIS_URL=redis://:password@localhost:6379/0

GEO_IP_URL=localhost:4360

# CORS: canonical comma-separated origin list. Drives API CORS
# (bootstrap/configure-app.ts), better-auth trusted origins (modules/auth/auth.ts),
# and S3 bucket CORS (modules/storage). Default: http://localhost:5173,http://localhost:3000
# Deprecated alias: S3_CORS_ALLOWED_ORIGINS is read for one release, then removed.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Public API base URL. Unset = Telegram polling mode, set = Telegram webhook mode
# (modules/integrations/telegram-polling.service.ts:37-42). Default: empty (polling)
BASE_URL=

# Worker join secret. Must match the worker's value or join rejects
# with "Invalid worker signature" (modules/workers/workers.service.ts:564-570).
# Default: empty (set it in every deployment)
WORKER_SIGNATURE=change_me

# Envelope encryption: comma-separated KEKs. Last key = active (encrypt + decrypt), older = decrypt-only
ENCRYPTION_KEYS=your-encryption-key-change-in-production

# RustFS Configuration
RUSTFS_ENDPOINT=http://localhost:9000
# Vendor names kept for the RustFS container + nginx signer (mapped by compose).
# Deprecated as API credential inputs: RUSTFS_ACCESS_KEY/RUSTFS_SECRET_KEY are
# read as an alias pair for one release, then removed. Set S3_ACCESS_KEY/S3_SECRET_KEY instead.
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfssecret

# Object storage presign settings (S3-compatible). Unset keys fall back to the
# defaults documented below, so only override what your deployment differs on.
# Browser-reachable origin used to SIGN presigned URLs (the API must still talk
# to RUSTFS_ENDPOINT). Defaults to RUSTFS_ENDPOINT, else http://localhost:9000.
# Profile A — self-hosted (same-origin nginx proxy): S3_PUBLIC_ENDPOINT MUST
# equal the console origin, or the unsigned `location ^~ /system/` and
# `location ^~ /cached-static/` prefixes in console/nginx.conf are bypassed and
# plain public GETs fall through to the SPA. Docker-compose value is the console
# origin (http://localhost:3000); plain-API default stays http://localhost:9000
# for direct browser-to-RustFS access outside compose.
# Profile B — cloud (AWS S3): S3_PUBLIC_ENDPOINT=https://s3.<region>.amazonaws.com
# with S3_FORCE_PATH_STYLE=false, so signed URLs are virtual-hosted
# (https://<bucket>.s3.<region>.amazonaws.com/<key>). The operator must disable
# S3 Block Public Access on the public buckets (`system`, `cached-static`) or the
# app applies PutPublicAccessBlock itself at boot (best-effort).
S3_PUBLIC_ENDPOINT=http://localhost:9000
# Object storage region (AWS: the bucket's real region). Default: us-east-1
S3_REGION=us-east-1
# true for RustFS/MinIO, false for AWS S3. Default: true
S3_FORCE_PATH_STYLE=true
# Same-origin prefix the browser hits for storage URLs. EMPTY => absolute mode
# (the existing behavior: URLs are built from S3_PUBLIC_ENDPOINT; cloud sets
# S3_PUBLIC_ENDPOINT + S3_FORCE_PATH_STYLE and leaves this empty). NON-EMPTY =>
# relative mode (dev/docker): browser URLs become `${STORAGE_URL_BASE}/<bucket>/<key>`
# (with `?X-Amz-...` for tenant/private buckets, signed against RUSTFS_ENDPOINT
# path-style). The proxy (nginx/vite) MUST strip this prefix and forward with
# Host == the RUSTFS_ENDPOINT host. Default: /api/storage
STORAGE_URL_BASE=/api/storage
# Presigned URL lifetime in seconds. Default: 172800 (2 days), clamped to [60, 172800].
# URLs are signed with an hour-bucketed signing date (start of the current UTC
# hour), so repeated presigns within the same hour emit identical URLs.
S3_PRESIGN_TTL=172800
# Deprecated alias of CORS_ALLOWED_ORIGINS (read for one release, then removed).
# Set CORS_ALLOWED_ORIGINS instead. Bucket CORS follows the same list, so
# cross-origin direct fetches of public objects need their origin listed there.
S3_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Canonical static credentials. Used when BOTH are set. Default: empty
S3_ACCESS_KEY=
S3_SECRET_KEY=
# true omits static credentials so the AWS default provider chain (IAM role)
# applies. Default: false (use in cloud)
S3_USE_DEFAULT_CREDENTIALS=false

# Audit log retention: directory where expired audit rows are archived to
# per-day JSONL files before deletion (defaults to ./audit-archive)
AUDIT_ARCHIVE_DIR=./audit-archive