# Config database
POSTGRES_HOST=localhost
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
POSTGRES_DB=open_asm
POSTGRES_SSL=false

PORT=6276
GRPC_PORT=16276
OASM_CLOUD_APIKEY=change_me
REDIS_URL=redis://:password@localhost:6379/0

GEO_IP_URL=localhost:4360

# Envelope encryption: comma-separated KEKs. Last key = active (encrypt + decrypt), older = decrypt-only
ENCRYPTION_KEYS=your-encryption-key-change-in-production

# RustFS Configuration
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfssecret

# Workspace files: per-file upload limit and default per-workspace quota (bytes).
# Per-file limit is enforced by the storage presigned POST policy (RustFS >= 1.0.0-alpha.83);
# keep it below the console nginx client_max_body_size (100m) for /api/storage/.
ARTIFACT_MAX_FILE_BYTES=52428800
ARTIFACT_WORKSPACE_QUOTA_BYTES=1073741824

# Audit log retention: directory where expired audit rows are archived to
# per-day JSONL files before deletion (defaults to ./audit-archive)
AUDIT_ARCHIVE_DIR=./audit-archive

# Reverse proxies in front of core-api (comma-separated IPs/CIDRs). Their
# X-Forwarded-For hops are skipped to find the real client IP (auth rate limit,
# worker IP). Leave empty when clients connect directly.
# Example behind nginx/cloudflared in Docker: TRUSTED_PROXIES=172.16.0.0/12
TRUSTED_PROXIES=
