# Config database
POSTGRES_HOST=localhost
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
POSTGRES_DB=open_asm
POSTGRES_SSL=false

PORT=6276
GRPC_PORT=16276
OASM_CLOUD_APIKEY=change_me
REDIS_URL=redis://:password@localhost:6379/0

GEO_IP_URL=localhost:4360

# Session signing secret for better-auth. REQUIRED.
# Generate with: openssl rand -base64 32
# The app refuses to boot without it — better-auth's own fallback is the
# constant "better-auth-secret-12345678901234567890", published in its npm
# package, which makes every session cookie forgeable.
BETTER_AUTH_SECRET=replace_me_generate_with_openssl_rand_base64_32

# Cross-origin origins allowed to make credentialed requests. Comma-separated.
# Leave empty to trust same-origin only. Set this when the console is served
# from a different origin than the API, e.g.
#   TRUSTED_ORIGINS=https://app.example.com,https://admin.example.com
TRUSTED_ORIGINS=

# Send the session cookie with the `Secure` attribute. Defaults to true when
# NODE_ENV=production. Set explicitly to true when terminating TLS upstream.
COOKIE_SECURE=false

# Envelope encryption: comma-separated KEKs. Last key = active (encrypt + decrypt), older = decrypt-only
# REQUIRED. Generate each with: openssl rand -base64 32
# The app refuses to boot with a placeholder value or with the former
# hard-coded default, so that encrypted columns are never readable via a
# key published in this repository.
ENCRYPTION_KEYS=your-encryption-key-change-in-production

# RustFS Configuration
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfssecret

# Audit log retention: directory where expired audit rows are archived to
# per-day JSONL files before deletion (defaults to ./audit-archive)
AUDIT_ARCHIVE_DIR=./audit-archive