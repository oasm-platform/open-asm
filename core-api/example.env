# Config database
POSTGRES_HOST=localhost
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
POSTGRES_DB=open_asm
POSTGRES_SSL=false

PORT=6276
GRPC_PORT=16276

# Signs session cookies and email verification links. Required outside local
# development: the API won't start without it, since with a known value anyone
# can forge both. Generate one with: openssl rand -base64 32
# Changing it signs everyone out and voids verification links already sent.
BETTER_AUTH_SECRET=

# Public URL of the console, origin only (e.g. https://app.example.com). Links
# the API hands out are built from it: email verification links and the
# Telegram webhook. Leave empty for local development: auth links then use the
# request's host, and Telegram falls back to polling.
BASE_URL=

OASM_CLOUD_APIKEY=change_me
REDIS_URL=redis://:password@localhost:6379/0

GEO_IP_URL=localhost:4360

# Envelope encryption: comma-separated keys protecting stored credentials. The
# last key encrypts; earlier keys only decrypt. Outside local development the
# last key must be random and 32+ characters (openssl rand -base64 32), or the
# API won't start. To rotate, add the new key at the end: data under the older
# keys, or under the built-in default, stays readable and is re-encrypted with
# the new key at boot. Drop an old key only once the boot log says no stored
# secret needs it.
ENCRYPTION_KEYS=your-encryption-key-change-in-production

# RustFS Configuration
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfssecret

# Audit log retention: directory where expired audit rows are archived to
# per-day JSONL files before deletion (defaults to ./audit-archive)
AUDIT_ARCHIVE_DIR=./audit-archive

# Reverse proxies in front of core-api (comma-separated IPs/CIDRs). Their
# X-Forwarded-For hops are skipped to find the real client IP (auth rate limit,
# worker IP). Leave empty when clients connect directly.
# Example behind nginx/cloudflared in Docker: TRUSTED_PROXIES=172.16.0.0/12
TRUSTED_PROXIES=
