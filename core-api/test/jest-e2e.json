{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts",
    "tsx"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.m?(t|j)sx?$": [
      "@swc/jest",
      {
        "jsc": {
          "parser": {
            "syntax": "typescript",
            "decorators": true
          },
          "target": "es5",
          "transform": {
            "legacyDecorator": true,
            "decoratorMetadata": true
          }
        },
        "module": {
          "type": "commonjs",
          "noInterop": true
        }
      }
    ]
  },
  "moduleNameMapper": {
    "^@/(.*)$": "../src/$1"
  },
  "transformIgnorePatterns": []
}
