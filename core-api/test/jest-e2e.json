{
  "moduleFileExtensions": ["js", "json", "ts", "tsx"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.m?(t|j)sx?$": [
      "./swc-jest-transform.cjs",
      {}
    ]
  },
  "moduleNameMapper": {
    "^@/(.*)$": "../src/$1",
    "^@react-pdf/renderer$": "<rootDir>/stubs/react-pdf-renderer.js"
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(?:.pnpm/[^/]+/node_modules/)?(?:better-auth|better-call|@better-auth|@better-fetch|@noble|@opentelemetry|@standard-schema|@formatjs|@nestjs|intl-messageformat|rou3|set-cookie-parser|kysely|nanostores|zod|defu|jose|file-type|load-esm|uid|react|react-dom)(?:/|$))"
  ]
}
