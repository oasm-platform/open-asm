WORKER_API_KEY=
# Name shown in the console. Empty = the OS hostname (a container ID in Docker).
WORKER_NAME=
# Concurrency auto-sizes from available CPU/RAM when unset (or 0).
# Set a positive value to pin it (default: 0 = auto).
WORKER_MAX_CONCURRENCY=
WORKER_GRPC_HOST=localhost
WORKER_GRPC_PORT=16276
# TLS to core-api; required for cloud.oasm.io:443 (through Cloudflare)
WORKER_TLS_ENABLED=false
# Connector egress proxy: internal listener (default 26277) that connector
# containers route outbound traffic through. off restores direct egress.
WORKER_EGRESS_PORT=26277
WORKER_EGRESS_PROXY=on
# Agent host shell commands (not WORKER_AGENT_SANDBOX ones) also go through it
# via HTTP(S)_PROXY, and their requests are logged to core-api.
# Non-public IPs/CIDRs the egress proxy may still reach, e.g. an on-prem
# Nessus or Acunetix: WORKER_EGRESS_ALLOW=10.0.5.20,192.168.10.0/24
WORKER_EGRESS_ALLOW=
# Resolvers built-in naabu uses, comma-separated IP[:port].
# Empty = the nameservers in /etc/resolv.conf; off = naabu's public
# resolvers (1.1.1.1, 8.8.8.8, ...), which fail where outbound DNS is blocked.
WORKER_DNS_RESOLVERS=
