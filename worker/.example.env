WORKER_API_KEY=
# Concurrency auto-sizes from available CPU/RAM when unset (or 0).
# Set a positive value to pin it (default: 0 = auto).
WORKER_MAX_CONCURRENCY=
WORKER_GRPC_HOST=localhost
WORKER_GRPC_PORT=16276
# Worker run mode: "cli" (interactive TUI) or "node" (headless worker node). Default: "" (entrypoint default; Docker image sets node). # see internal/config/config.go:79
WORKER_MODE=
# Local tool archive cache dir (default: oasm-tools). # see internal/config/config.go:73
WORKER_TOOL_PATH=oasm-tools
# Join identity file; persists the worker token across restarts (default: <cwd>/.worker-token). # see internal/grpcclient/client.go:126
WORKER_TOKEN_FILE=
# Dial address (host:port) connector containers use to reach the worker's connector server, e.g. host.docker.internal:26276 (default: "" = fail fast unless autodetect opted in). # see internal/config/config.go:76
WORKER_CONNECTOR_ADDR=
# Dev-only opt-in restoring the legacy auto-derive chain (self-IP -> host.docker.internal -> bridge gateway -> 172.17.0.1) with a warning (default: false). # see internal/config/config.go:77
WORKER_CONNECTOR_ADDR_ALLOW_AUTODETECT=
# Connector mTLS: all three must be set (PEM paths) to activate; otherwise the connector server stays plaintext. # see internal/connector/mtls.go:26-28
WORKER_CONNECTOR_TLS_CERT=
WORKER_CONNECTOR_TLS_KEY=
WORKER_CONNECTOR_TLS_CA=
# Stable worker identity signature sent with Join; pins identity across token-file loss (default: ""). # see internal/grpcclient/client.go:110
WORKER_SIGNATURE=
# Warm-pool container reuse kill-switch (default: true; false restores legacy 1-stream-1-container). # see internal/config/config.go:80
WORKER_POOL_ENABLED=
# Seconds an idle pooled container may stay alive before the sweeper removes it (default: 60). # see internal/config/config.go:81
WORKER_CONNECTOR_IDLE_TIMEOUT=
# Docker engine endpoint override. Precedence: explicit host arg > WORKER_DOCKER_HOST > DOCKER_HOST > platform default (unix:///var/run/docker.sock, npipe on Windows). DOCKER_HOST is the standard fallback. # see internal/runtime/docker.go:217-226,259
WORKER_DOCKER_HOST=
