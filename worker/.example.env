WORKER_API_KEY=
# Concurrency auto-sizes from available CPU/RAM when unset (or 0).
# Set a positive value to pin it (default: 0 = auto).
WORKER_MAX_CONCURRENCY=
WORKER_GRPC_HOST=localhost
WORKER_GRPC_PORT=16276
# TLS to core-api; required for cloud.oasm.io:443 (through Cloudflare)
WORKER_TLS_ENABLED=false
